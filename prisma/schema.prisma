generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String      @id @default(cuid())
  email                String      @unique
  username             String
  password             String

  attendedUniversityId String?   @map("attended_university_id")
  attendedUniversity   University? @relation(fields: [attendedUniversityId], references: [id])

  joinedAt             DateTime    @default(now())  @map("joined_at")

  @@map("users")
} 

model University {
  id        String  @id @default(cuid())
  name      String

  students  User[]

  @@map("universities")
}
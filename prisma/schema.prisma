generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  username String
  password String

  attendedUniversityId String?     @map("attended_university_id")
  attendedUniversity   University? @relation(fields: [attendedUniversityId], references: [id])

  psycometry Int?

  birthYear Int?

  joinedAt DateTime @default(now()) @map("joined_at")

  hobbies Hobby[]

  @@map("users")
}

model University {
  id         String  @id @default(cuid())
  name       String
  country    String?
  externalId String? @unique // ID from the public API

  users   User[]
  degrees Degree[]

  @@map("universities")
}

model Degree {
  id           String     @id @default(cuid())
  name         String
  type         String
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id])

  @@map("degrees")
}

model Hobby {
  id   String @id @default(cuid())
  name String @unique

  users User[]

  @@map("hobbies")
}
